# Copy to .env and fill in to enable speech-to-text (Phase 4).
# These are read at build time by Expo (EXPO_PUBLIC_ prefix = client-visible).

# Supabase project URL (enables sign-in + cloud sync). Leave blank for
# local-only mode (the app still works without a backend).
#   https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# URL of the deployed `transcribe` Edge Function:
#   https://<your-project-ref>.functions.supabase.co/transcribe
EXPO_PUBLIC_TRANSCRIBE_URL=

# URL of the deployed `cleanup` Edge Function (Phase 5):
#   https://<your-project-ref>.functions.supabase.co/cleanup
EXPO_PUBLIC_CLEANUP_URL=

# URL of the deployed `detect-goals` Edge Function (Phase 8):
#   https://<your-project-ref>.functions.supabase.co/detect-goals
EXPO_PUBLIC_DETECT_GOALS_URL=

# Supabase anon (public) key — safe to ship in a client app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
