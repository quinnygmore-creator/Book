# Copy to .env and fill in to enable speech-to-text (Phase 4).
# These are read at build time by Expo (EXPO_PUBLIC_ prefix = client-visible).

# URL of the deployed `transcribe` Edge Function:
#   https://<your-project-ref>.functions.supabase.co/transcribe
EXPO_PUBLIC_TRANSCRIBE_URL=

# Supabase anon (public) key — safe to ship in a client app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
